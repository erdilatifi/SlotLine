# Copy to .env and adjust for your machine. .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
JWT_SECRET=change-me-to-a-random-32+-character-string
FRONTEND_URL=http://localhost:5173

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://slotline:slotline@localhost:5432/slotline

# Matches docker-compose.yml's maildev service — every email the app sends
# locally lands here instead of a real inbox. Open http://localhost:1080.
SMTP_HOST=localhost
SMTP_PORT=1025

# Google Calendar sync. Create an OAuth client (type: Web application) in a
# Google Cloud project with the Calendar API enabled, and add the redirect
# URI below to its authorised list. Free within Google's standard quota.
# Calendar sync stays disabled if these are left unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/callback

# 32 random bytes, base64. Encrypts Google refresh tokens before they touch
# the database: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
ENCRYPTION_KEY=
